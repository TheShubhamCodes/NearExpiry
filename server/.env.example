# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Supports local MongoDB and MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/nearexpiry

# Security & Authentication
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Resend Email Service (Phase 7)
# Get your API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here
# Note: For free testing with Resend, use "NearExpiry <onboarding@resend.dev>" or your verified custom domain
EMAIL_FROM=NearExpiry <onboarding@resend.dev>

