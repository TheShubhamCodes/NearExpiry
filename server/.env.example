# ============================================================
# NearExpiry Backend — Environment Configuration Example
# ============================================================
# Copy this file to .env for local development.
# In production (Render), set these values in the Service Environment tab.
# NEVER commit real .env files or real secrets to Git.

# Server Port (Render injects PORT automatically in production)
PORT=5000

# Runtime Environment: development | production
NODE_ENV=development

# MongoDB Connection String
# Local development:
MONGODB_URI=mongodb://localhost:27017/nearexpiry
# Production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<username>:<url_encoded_password>@<cluster>.mongodb.net/nearexpiry?retryWrites=true&w=majority

# JWT Signing Secret (Minimum 32 random characters required in production)
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Primary Frontend Origin for CORS & CSRF Validation (no trailing slash)
# Local development:
CLIENT_URL=http://localhost:5173
# Production (Vercel):
# CLIENT_URL=https://your-nearexpiry-app.vercel.app

# Optional: Comma-separated additional allowed origins (e.g., custom domain or preview URL)
# CORS_ORIGINS=https://portal.yourstore.com

# Optional: Override HTTP-only JWT cookie SameSite policy (defaults to "lax" in dev, "none" in prod)
# COOKIE_SAME_SITE=none

# Optional: Resend Transactional Email Alerts (Phase 7)
# Leave blank to run without outbound emails (alerts will be skipped gracefully)
RESEND_API_KEY=
# Note: Free Resend testing with onboarding@resend.dev only sends to your own verified Resend account email.
# Verify your custom domain in Resend to send emails to any staff member.
EMAIL_FROM=NearExpiry <onboarding@resend.dev>

# Optional: Cloudinary Product Image Uploads
# If omitted, staff can still paste external https:// image URLs or use Open Food Facts images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
