# ============================================================
# NearExpiry Frontend — Environment Configuration Example
# ============================================================
# Copy this file to .env for local development.
# On Vercel, configure VITE_API_URL in Project Settings -> Environment Variables
# and trigger a fresh deployment (Vite bakes VITE_* variables at build time).

# Local Development (proxied by Vite dev server in vite.config.js to http://localhost:5000):
VITE_API_URL=/api

# Production (Vercel -> Render Backend API base URL ending with /api, NO trailing slash):
# VITE_API_URL=https://your-nearexpiry-api.onrender.com/api
